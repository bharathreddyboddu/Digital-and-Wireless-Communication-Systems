- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"Frame sync + de-whitening (RX).  Input: one hard bit (0/1)\
      \ per byte.  Output: PCM bytes.\n\nTX frame = 4 sync bytes + 250 PCM bytes,\
      \ whole frame XOR-ed with a fixed 254-byte whitening mask\n(mask[0:4] = 0, so\
      \ the sync word goes on air unchanged).  This block finds the sync word at any\
      \ bit\noffset and with either BPSK polarity (the Costas loop may lock inverted),\
      \ removes the whitening and\nhands back byte-aligned PCM.  While no sync is\
      \ found it outputs silence (0x80).\"\"\"\nimport numpy as np\nfrom gnuradio\
      \ import gr\n\nSYNC = [0x1A, 0xCF, 0xFC, 0x1D]\nPAYLOAD = 250\nFRAME_BYTES =\
      \ 254\nWHITEN = [0, 0, 0, 0, 112, 170, 210, 19, 134, 138, 63, 173, 147, 211,\
      \ 72, 75, 82, 42, 12, 145, 72, 179, 225, 213, 165, 46, 28, 247, 172, 201, 253,\
      \ 94, 123, 155, 192, 78, 95, 2, 234, 37, 92, 135, 244, 103, 66, 43, 51, 246,\
      \ 124, 37, 254, 201, 253, 24, 78, 120, 47, 43, 212, 190, 36, 53, 107, 222, 137,\
      \ 113, 160, 49, 139, 130, 138, 103, 22, 135, 180, 73, 41, 20, 189, 241, 234,\
      \ 77, 168, 7, 21, 192, 149, 185, 217, 45, 184, 163, 67, 98, 193, 95, 34, 101,\
      \ 42, 148, 152, 211, 88, 149, 186, 122, 253, 144, 148, 135, 60, 93, 126, 173,\
      \ 19, 162, 145, 64, 230, 65, 164, 76, 129, 89, 45, 24, 202, 18, 23, 190, 151,\
      \ 127, 51, 125, 68, 51, 32, 56, 84, 68, 255, 113, 203, 239, 155, 101, 110, 138,\
      \ 23, 13, 25, 83, 127, 65, 47, 34, 136, 146, 122, 149, 118, 22, 247, 237, 238,\
      \ 186, 184, 125, 84, 219, 170, 80, 213, 244, 179, 6, 35, 68, 4, 101, 30, 138,\
      \ 23, 5, 24, 156, 42, 129, 202, 186, 24, 73, 148, 178, 254, 254, 81, 200, 245,\
      \ 147, 54, 148, 57, 120, 60, 105, 19, 90, 152, 1, 19, 239, 81, 229, 217, 225,\
      \ 191, 43, 33, 214, 122, 82, 8, 129, 187, 217, 15, 30, 11, 214, 52, 226, 49,\
      \ 147, 203, 100, 10, 113, 114, 102, 191, 156, 110, 69, 120, 248, 238, 24, 165,\
      \ 232, 253, 198, 34, 94]\nS = 32\nF = FRAME_BYTES * 8\n\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Frame sync, polarity fix, de-whiten\"\"\"\n\n    def __init__(self,\
      \ search_thr=30, lock_thr=22, max_miss=2):\n        gr.basic_block.__init__(self,\
      \ name=\"Frame Sync\", in_sig=[np.uint8], out_sig=[np.uint8])\n        self.search_thr\
      \ = int(search_thr)\n        self.lock_thr = int(lock_thr)\n        self.max_miss\
      \ = int(max_miss)\n        self.sync_pm = np.unpackbits(np.array(SYNC, dtype=np.uint8)).astype(np.float32)\
      \ * 2 - 1\n        self.mask_bits = np.unpackbits(np.array(WHITEN[4:], dtype=np.uint8))\n\
      \        self.silence = np.full(PAYLOAD, 128, dtype=np.uint8)\n        self.buf\
      \ = np.zeros(0, dtype=np.float32)\n        self.pend = np.zeros(0, dtype=np.uint8)\n\
      \        self.locked = False\n        self.pol = 1.0\n        self.miss = 0\n\
      \n    def forecast(self, noutput_items, ninputs):\n        return [min(max(8\
      \ * noutput_items, 1), 2048)] * ninputs\n\n    def _emit_silence(self):\n  \
      \      self.pend = np.concatenate((self.pend, self.silence))\n\n    def _emit_frame(self):\n\
      \        bits = ((self.buf[S:F] * self.pol) > 0).astype(np.uint8) ^ self.mask_bits\n\
      \        self.pend = np.concatenate((self.pend, np.packbits(bits)))\n\n    def\
      \ _set_lock(self, state):\n        if state != self.locked:\n            self.locked\
      \ = state\n            print(\"[Frame Sync] %s\" % (\"LOCKED (polarity %s)\"\
      \ % (\"normal\" if self.pol > 0 else \"inverted\")\n                       \
      \               if state else \"LOST - searching\"), flush=True)\n\n    def\
      \ _process(self):\n        while len(self.buf) >= F + S:\n            if self.locked:\n\
      \                c0 = self.pol * float(np.dot(self.buf[:S], self.sync_pm))\n\
      \                if c0 >= self.lock_thr:\n                    self.miss = 0\n\
      \                    self._emit_frame()\n                    self.buf = self.buf[F:]\n\
      \                    continue\n            c = np.correlate(self.buf[:F + S],\
      \ self.sync_pm, 'valid')[:F]\n            a = np.abs(c)\n            hits =\
      \ np.flatnonzero(a >= self.search_thr)\n            if len(hits):\n        \
      \        i = int(hits[0])\n                new_pol = 1.0 if c[i] > 0 else -1.0\n\
      \                if not self.locked:\n                    self.pol = new_pol\n\
      \                    self._set_lock(True)\n                else:\n         \
      \           if i > 0:\n                        self._emit_silence()      # a\
      \ slip happened: this frame is lost\n                    self.pol = new_pol\n\
      \                self.miss = 0\n                self.buf = self.buf[i:]\n  \
      \              continue\n            # no sync word anywhere in this frame-sized\
      \ window\n            if self.locked:\n                self.miss += 1\n    \
      \            if self.miss >= self.max_miss:\n                    self._set_lock(False)\n\
      \                    self._emit_silence()\n                else:\n         \
      \           self._emit_frame()\n            else:\n                self._emit_silence()\n\
      \            self.buf = self.buf[F:]\n\n    def general_work(self, input_items,\
      \ output_items):\n        out = output_items[0]\n        if len(self.pend) <\
      \ 8 * PAYLOAD:\n            take = min(len(input_items[0]), 16384)\n       \
      \     if take > 0:\n                x = input_items[0][:take]\n            \
      \    self.buf = np.concatenate((self.buf, x.astype(np.float32) * 2 - 1))\n \
      \               self.consume(0, take)\n                self._process()\n   \
      \     n = min(len(self.pend), len(out))\n        if n:\n            out[:n]\
      \ = self.pend[:n]\n            self.pend = self.pend[n:]\n        return n\n"
    affinity: ''
    alias: ''
    comment: frame sync + polarity fix + de-whitening; prints LOCKED / LOST in the
      console
    lock_thr: '22'
    max_miss: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
    search_thr: '30'
  states:
    _io_cache: ('Frame Sync', 'blk', [('search_thr', '30'), ('lock_thr', '22'), ('max_miss',
      '2')], [('0', 'byte', 1)], [('0', 'byte', 1)], 'Frame sync, polarity fix, de-whiten',
      ['lock_thr', 'max_miss', 'search_thr'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1904, 228.0]
    rotation: 0
    state: enabled
