      170, 80, 213, 244, 179, 6, 35, 68, 4, 101, 30, 138, 23, 5, 24, 156, 42, 129,
      202, 186, 24, 73, 148, 178, 254, 254, 81, 200, 245, 147, 54, 148, 57, 120, 60,
      105, 19, 90, 152, 1, 19, 239, 81, 229, 217, 225, 191, 43, 33, 214, 122, 82,
      8, 129, 187, 217, 15, 30, 11, 214, 52, 226, 49, 147, 203, 100, 10, 113, 114,
      102, 191, 156, 110, 69, 120, 248, 238, 24, 165, 232, 253, 198, 34, 94]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 484.0]
    rotation: 0
    state: enabled
- name: blocks_xor_xx_0
  id: blocks_xor_xx
